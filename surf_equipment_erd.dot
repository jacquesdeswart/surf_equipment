digraph surf_equipment {
  graph [rankdir=LR];
  node [shape=plain];
  edge [fontname="Helvetica"];
  "sails" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>sails</B></TD></TR><TR><TD ALIGN="LEFT">PK sail_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> area : REAL</TD></TR><TR><TD ALIGN="LEFT"> discipline : TEXT</TD></TR><TR><TD ALIGN="LEFT"> mast_length : INTEGER</TD></TR><TR><TD ALIGN="LEFT"> mast_diameter_ind : TEXT</TD></TR><TR><TD ALIGN="LEFT"> mast_curve_ind : TEXT</TD></TR><TR><TD ALIGN="LEFT"> boom_length_ind : TEXT</TD></TR><TR><TD ALIGN="LEFT"> brand : TEXT</TD></TR><TR><TD ALIGN="LEFT"> model : TEXT</TD></TR><TR><TD ALIGN="LEFT"> cambers : TEXT</TD></TR><TR><TD ALIGN="LEFT"> color : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "masts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>masts</B></TD></TR><TR><TD ALIGN="LEFT">PK mast_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> length : INTEGER</TD></TR><TR><TD ALIGN="LEFT"> diameter : TEXT</TD></TR><TR><TD ALIGN="LEFT"> carbon_perc : INTEGER</TD></TR><TR><TD ALIGN="LEFT"> curve : TEXT</TD></TR><TR><TD ALIGN="LEFT"> bag : TEXT</TD></TR><TR><TD ALIGN="LEFT"> brand : TEXT</TD></TR><TR><TD ALIGN="LEFT"> model : TEXT</TD></TR><TR><TD ALIGN="LEFT"> color : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "extensions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>extensions</B></TD></TR><TR><TD ALIGN="LEFT">PK extension_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> brand : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "base_pulleys" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>base_pulleys</B></TD></TR><TR><TD ALIGN="LEFT">PK base_pulley_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> length_range : TEXT</TD></TR><TR><TD ALIGN="LEFT"> diameter : TEXT</TD></TR><TR><TD ALIGN="LEFT"> brand : TEXT</TD></TR><TR><TD ALIGN="LEFT"> color : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "booms" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>booms</B></TD></TR><TR><TD ALIGN="LEFT">PK boom_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> Length range : TEXT</TD></TR><TR><TD ALIGN="LEFT"> Brand : TEXT</TD></TR><TR><TD ALIGN="LEFT"> Model : TEXT</TD></TR><TR><TD ALIGN="LEFT"> Origin : TEXT</TD></TR></TABLE>>];
  "rdm_sdm_shims" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>rdm_sdm_shims</B></TD></TR><TR><TD ALIGN="LEFT">PK rdm_sdm_shim_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> color : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "uphauls" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>uphauls</B></TD></TR><TR><TD ALIGN="LEFT">PK uphaul_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> color : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "harness_lines" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>harness_lines</B></TD></TR><TR><TD ALIGN="LEFT">PK harness_line_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> color : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "boards" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>boards</B></TD></TR><TR><TD ALIGN="LEFT">PK board_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> story : TEXT</TD></TR><TR><TD ALIGN="LEFT"> volume : INTEGER</TD></TR><TR><TD ALIGN="LEFT"> brand : TEXT</TD></TR><TR><TD ALIGN="LEFT"> model : TEXT</TD></TR><TR><TD ALIGN="LEFT"> vin : TEXT</TD></TR><TR><TD ALIGN="LEFT"> daggerboard : TEXT</TD></TR><TR><TD ALIGN="LEFT"> origin : TEXT</TD></TR></TABLE>>];
  "rigs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>rigs</B></TD></TR><TR><TD ALIGN="LEFT">PK rig_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> sail_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> mast_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> base_pulley_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> base_pulley_lenght_setting : TEXT</TD></TR><TR><TD ALIGN="LEFT"> extension_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> extension_length_setting : TEXT</TD></TR><TR><TD ALIGN="LEFT"> boom_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> boom_length_setting : REAL</TD></TR><TR><TD ALIGN="LEFT"> rdm_sdm_shim_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> uphaul_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> harness_line_id : TEXT</TD></TR></TABLE>>];
  "rig_board" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7"><B>rig_board</B></TD></TR><TR><TD ALIGN="LEFT">PK rig_board_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> board_id : TEXT</TD></TR><TR><TD ALIGN="LEFT"> rig_id : TEXT</TD></TR></TABLE>>];
  "harness_lines" -> "rigs" [label="harness_line_id -> harness_line_id", taillabel="1", headlabel="∞"];
  "uphauls" -> "rigs" [label="uphaul_id -> uphaul_id", taillabel="1", headlabel="∞"];
  "rdm_sdm_shims" -> "rigs" [label="rdm_sdm_shim_id -> rdm_sdm_shim_id", taillabel="1", headlabel="∞"];
  "booms" -> "rigs" [label="boom_id -> boom_id", taillabel="1", headlabel="∞"];
  "extensions" -> "rigs" [label="extension_id -> extension_id", taillabel="1", headlabel="∞"];
  "base_pulleys" -> "rigs" [label="base_pulley_id -> base_pulley_id", taillabel="1", headlabel="∞"];
  "masts" -> "rigs" [label="mast_id -> mast_id", taillabel="1", headlabel="∞"];
  "sails" -> "rigs" [label="sail_id -> sail_id", taillabel="1", headlabel="∞"];
  "rigs" -> "rig_board" [label="rig_id -> rig_id", taillabel="1", headlabel="∞"];
  "boards" -> "rig_board" [label="board_id -> board_id", taillabel="1", headlabel="∞"];
}
